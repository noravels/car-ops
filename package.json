{
  "name": "car-ops",
  "version": "0.1.0",
  "description": "AI-assisted used-car evaluation pipeline (career-ops patterns, TR-first, multi-market)",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "node --test",
    "degerleme": "node valuation-cli.mjs",
    "oneri": "node catalog.mjs --suggest",
    "katalog": "node catalog.mjs",
    "tamir": "node doctor.mjs",
    "tarama": "node market-scan.mjs",
    "test:providers": "node --test tests/providers/contract.test.mjs",
    "check:providers": "node provider-check.mjs",
    "check:providers:live": "node provider-check.mjs --live",
    "provider:defter": "node providers/generic.mjs",
    "check:all": "npm test && npm run check:providers",
    "rapor": "node report-export.mjs --adaylar data/candidates/egea-cross-2026-09-19.json --baslik 'Egea Cross — aday karşılaştırması'",
    "rapor:pdf": "node scripts/print-pdf.mjs --html reports/karsilastirma.html --pdf reports/karsilastirma.pdf"
  },
  "engines": {
    "node": ">=20"
  }
}